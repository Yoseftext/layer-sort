# Dedicated editor/engine caches and generated build outputs.
/.godot/

# Mono/.NET crash dumps
/mono_crashes.d.*

# Spike build outputs (uploaded as CI artifacts, never committed)
/build/

# CI log captures
/logs/

# Runtime device QA evidence is generated locally and may contain screenshots.
/.runtime/

# Debug signing material must never enter Git.
*.keystore
*.jks
secrets/
.env

# Python bytecode from local syntax checks
__pycache__/
*.pyc

# Nested agent worktrees; all worktrees must remain under this ignored directory.
.worktrees/
