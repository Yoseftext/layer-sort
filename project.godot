; Engine configuration file.
; Spike project: minimal Godot 4.7.2 .NET (C#) build-spike for Android.
; No gameplay implementation - this only proves the build pipeline works.

config_version=5

[application]

config/name="Layer Sort — Build Spike"
config/version="0.1.0"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#")
config/icon="res://icon.svg"

[dotnet]

project/assembly_name="LayerSort"

[rendering]

; Required for Android export validation (Godot 4.7.2-stable
; export_plugin.cpp / has_valid_project_configuration): texture compression
; support for ETC2/ASTC must be enabled or the export configuration check
; fails with "ETC2/ASTC texture compression is required for Android export."
; Observed in run 39944193566.
textures/vram_compression/import_etc2_astc=true
