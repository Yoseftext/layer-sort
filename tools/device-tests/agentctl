#!/usr/bin/bash
# Single allowlisted entrypoint for Layer Sort device QA.
# No generic phone command, arbitrary ADB, install, uninstall, or data wipe.
set -Eeuo pipefail

SCRIPT_DIR="${BASH_SOURCE[0]%/*}"
ROOT="$(cd -- "$SCRIPT_DIR/../.." && pwd -P)"
exec /usr/bin/python3.13 -I "$ROOT/tools/device-tests/device_qa.py" "$@"
